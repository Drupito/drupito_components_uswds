{% set summary_box_id = heading|clean_unique_id %}

<div {{ attributes.addClass('usa-summary-box').setAttribute('role', 'region').setAttribute('aria-labelledby', summary_box_id) }}

  <div class="usa-summary-box__body">
    <h4 class="usa-summary-box__heading" id="{{ summary_box_id }}">
      {{ heading }}
    </h4>
    <div class="usa-summary-box__text">
      <ul class="usa-list">
        {% for item in items %}
        {% set text_format = 'basic_html' %}
          <li>        
            {{ {
              '#type': 'processed_text',
              '#text': item,
              '#format': text_format,
            } }}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>
