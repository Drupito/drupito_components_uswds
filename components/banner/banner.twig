{% set classes = [
  'usa-banner'
] %}

{% set banner_id = 'banner-' ~ variant ~ '-' ~ random() %}
{% set icon_path = icon_path|default('https://designsystem.digital.gov/assets/img/') %}

<section {{ attributes.addClass(classes).setAttribute('aria-label', aria_label) }}>
	<div class="usa-accordion">
		<header class="usa-banner__header">
			<div class="usa-banner__inner">
				<div class="grid-col-auto">
					{% if not hide_icons %}
						<img aria-hidden="true" class="usa-banner__header-flag" src="{{ icon_path ~ 'us_flag_small.png' }}" alt=""/>
					{% endif %}
				</div>
				<div class="grid-col-fill tablet:grid-col-auto" aria-hidden="true">
					{% block custom_header %}
						<p class="usa-banner__header-text">
							{{ header_text }}
						</p>
						<p class="usa-banner__header-action">
							{{ action_text }}
						</p>
					{% endblock %}
				</div>
				<button type="button" class="usa-accordion__button usa-banner__button" aria-expanded="false" aria-controls="{{ banner_id }}">
					<span class="usa-banner__button-text">
						{{ action_text }}
					</span>
				</button>
			</div>
		</header>
		<div class="usa-banner__content usa-accordion__content" id="{{ banner_id }}">
			<div class="grid-row grid-gap-lg">
				{% block custom_guidance %}
					<div class="usa-banner__guidance tablet:grid-col-6">
						{% if not hide_icons %}
							<img class="usa-banner__icon usa-media-block__img" src="{{ icon_path ~ 'icon-dot-' ~ variant ~ '.svg' }}" alt="" aria-hidden="true"/>
						{% endif %}
						<div class="usa-media-block__body">
							<p>
								<strong>{{ domain_heading }}</strong><br/>
								{{ domain_body|raw }}
							</p>
						</div>
					</div>
					<div class="usa-banner__guidance tablet:grid-col-6">
						{% if not hide_icons %}
							<img class="usa-banner__icon usa-media-block__img" src="{{ icon_path ~ 'icon-https.svg' }}" alt="" aria-hidden="true"/>
						{% endif %}
						<div class="usa-media-block__body">
							<p>
								<strong>{{ secure_heading }}</strong><br/>
								{{ secure_body|raw }}
							</p>
						</div>
					</div>
				{% endblock %}
			</div>
		</div>
	</div>
</section>

