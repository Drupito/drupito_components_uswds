{% set classes = [
  'usa-accordion',
  multiselectable ? 'usa-accordion--multiselectable',
  bordered ? 'usa-accordion--bordered',
  save_state ? 'remember-state'
] %}

{# To avoid ID conflicts if there are multiple accordions on a page #}
{% set accordion_unique_id = random(1, 1000) %}

<div {{ attributes.addClass(classes).setAttribute('data-allow-multiple', multiselectable) }}>
  {#
    @TODO: Create separate accordion-item twig file or SDC
    to avoid repeating the same code for each item.
    
    Revisit after https://www.drupal.org/project/drupal/issues/3446933 is resolved.
  #}
  {% if item_1_heading_text %}
    {% set item_1_id = 'item_1-' ~ accordion_unique_id %}
    <h4 class="usa-accordion__heading">
      <button
        type="button"
        class="usa-accordion__button"
        aria-expanded="{{ item_1_expanded ? 'true' : 'false' }}"
        aria-controls="{{ item_1_id }}"
      >
        {{  item_1_heading_text }}
      </button>
    </h4>
    <div id="{{ item_1_id }}" class="usa-accordion__content usa-prose">
      {% block item_1_content %}
        {{ item_1_content }}
      {% endblock %}
    </div>
  {% endif %}
