<ol class="usa-process-list">
	{% for item in items %}
		{% set item_text_format = text_format ?? 'basic_html' %}

		{% set padding_class = (item.no_text or item.custom_heading_size) and not loop.last ? 'padding-bottom-4' : '' %}

		<li{{create_attribute().addClass('usa-process-list__item',padding_class)}}>
			{# Heading implementation #}
			{% if item.no_text %}
				<p class="usa-process-list__heading font-sans-xl line-height-sans-1">
					{{ item.heading }}
				</p>
			{% else %}
				<h{{item.heading_level|default(4)}} class="usa-process-list__heading {{ item.custom_heading_size ? 'font-sans-xl line-height-sans-1' }}">
					{{ item.heading }}
				</h{{item.heading_level|default(4)}}>
			{% endif %}

			{% if not item.no_text %}
				{% if item.custom_heading_size %}
					 <div class="font-sans-lg margin-top-1 text-light">
            {{ {
              '#type': 'processed_text',
              '#text': item.content,
              '#format': item.content_format|default('basic_html'),
            } }}
          </div>
        {% else %}
          <div class="margin-top-05">
            {{ {
              '#type': 'processed_text',
              '#text': item.content,
              '#format': item.content_format|default('basic_html'),
            } }}
          </div>

				{% endif %}
      {% endif %}
			</li>
		{% endfor %}
	</ol>
