<h1>Card Component Test Cases</h1>

<h2>1. Default Card</h2>

{% embed "drupito_components_uswds:card" %}
  {% block heading %}Card{% endblock %}
  {% block body %}
    <p>
      Lorem ipsum dolor sit amet consectetur adipisicing elit. Facilis earum
      tenetur quo cupiditate, eaque qui officia recusandae.
    </p>
  {% endblock %}
  {% block footer %}
    {% embed "drupito_components_uswds:button" with { button_text: 'Visit Florida Keys', url: '#' } only %}{% endembed %}
  {% endblock %}
{% endembed %}
<hr>

