<h1>Card Component Test</h1>

<h3 class="site-preview-heading">Default Card</h3>
<ul class="usa-card-group">
	{% embed "drupito_components_uswds:card" with {
    header_text: "Default Card",
    footer_text: "Visit Florida Keys",
    footer_url: "#"
  } only %}
		{% block body %}
			<p>Lorem ipsum dolor sit amet,
				<strong>consectetur</strong>
				adipisicing elit.</p>
		{% endblock %}
	{% endembed %}
</ul>

<h3 class="site-preview-heading">Default Card (Header Above)</h3>
<ul class="usa-card-group">
	{% embed "drupito_components_uswds:card" with {
    header_text: "Default Card (Header Above)",
    footer_text: "Visit Florida Keys",
    footer_url: "#",
    header_above: true
  } only %}
		{% block body %}
			<p>This is a default card with the
				<strong>header above</strong>.</p>
		{% endblock %}
	{% endembed %}
</ul>

<h3 class="site-preview-heading">Card with Media</h3>
<ul class="usa-card-group">
	{% embed "drupito_components_uswds:card" with {
    header_text: "Card with Media",
    has_media: true,
    media_image: "https://designsystem.digital.gov/img/introducing-uswds-2-0/built-to-grow--alt.jpg",
    media_alt: "A placeholder image",
    footer_text: "Visit Florida Keys",
    footer_url: "#"
  } only %}
		{% block body %}
			<p>This is a
				<strong>card</strong>
				with an image.</p>
		{% endblock %}
	{% endembed %}
</ul>

