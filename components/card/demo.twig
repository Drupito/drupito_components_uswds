<h1>Card Component Test</h1>

<h3 class="site-preview-heading">Default Card</h3>
<ul class="usa-card-group">
  {% embed "drupito_components_uswds:card" with {
    card_title: "Default Card"
  } only %}
    {% block body %}
      <p>Lorem ipsum dolor sit amet,
        <strong>consectetur</strong>
        adipisicing elit.</p>
    {% endblock %}
    {% block footer %}
      {% embed "drupito_components_uswds:button" with { button_text: "Learn More" } only %}{% endembed %}
    {% endblock %}
  {% endembed %}
</ul>

<h3 class="site-preview-heading">Default Card (Header Above)</h3>
<ul class="usa-card-group">
  {% embed "drupito_components_uswds:card" with {
        media_display: "exdent",
    card_title: "Default Card (Header Above)",
    header_above: true
  } only %}
    {% block body %}
      <p>This is a default card with the
        <strong>header above</strong>.</p>
    {% endblock %}
    {% block footer %}
      {% embed "drupito_components_uswds:button" with { button_text: "Learn More" } only %}{% endembed %}
    {% endblock %}
  {% endembed %}
</ul>

