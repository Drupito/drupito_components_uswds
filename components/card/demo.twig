{# Default #}

{% embed "drupito_components_uswds:card" with {
  card_title: "Default Card"
} only %}
  {% block body %}
    <p>Lorem ipsum dolor sit amet,
      <strong>consectetur</strong>
      adipisicing elit.</p>
  {% endblock %}
  {% block footer %}
    {% embed "drupito_components_uswds:button" with { button_text: "Learn More" } only %}{% endembed %}
  {% endblock %}
{% endembed %}


{# Card with Media #}

{% embed "drupito_components_uswds:card" with {
  card_title: "Card with Media",
  media_image: "https://designsystem.digital.gov/img/introducing-uswds-2-0/built-to-grow--alt.jpg",
  media_alt: "A placeholder image"
} only %}
  {% block body %}
    <p>This is a
      <strong>card</strong>
      with an image.</p>
  {% endblock %}
  {% block footer %}
    {% embed "drupito_components_uswds:button" with { button_text: "Learn More" } only %}{% endembed %}
  {% endblock %}
{% endembed %}


