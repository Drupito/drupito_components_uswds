{# components/card/card.twig #}
{% set card_classes = [
  'usa-card',
  flag_layout ? 'usa-card--flag' : '',
  media_right and flag_layout ? 'usa-card--media-right' : '',
] %}

{% set container_classes = [
  'usa-card__container'
] %}

{% set media_classes = [
  'usa-card__media',
  media_variant != 'default' ? 'usa-card__media--' ~ media_variant : ''
] %}

<div {{ attributes.addClass(card_classes) }}>
  <div class="{{ container_classes|join(' ') }}">

    {# Header Section #}
    <div class="usa-card__header">
      <h{{ heading_level|default(2) }} class="usa-card__heading">
        {% block heading %}{% endblock %}
      </h{{ heading_level|default(2) }}>
    </div>

    {# Media Section #}
    <div class="{{ media_classes|join(' ') }}">
      <div class="usa-card__img">
        {% block media %}{% endblock %}
      </div>
    </div>

    {# Body Content #}
    <div class="usa-card__body">
      {% block body %}{% endblock %}
    </div>

    {# Footer Section #}
    <div class="usa-card__footer">
      {% block footer %}{% endblock %}
    </div>
  </div>
</div>
