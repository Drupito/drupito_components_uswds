{% set card_classes = [
  'usa-card',
  flag_layout ? 'usa-card--flag flex-1' : 'tablet-lg:grid-col-6 widescreen:grid-col-4',
	
  media_position == 'right' ? 'usa-card--media-right' : '',
  header_first ? 'usa-card--header-first',
] %}

{% set media_attributes = {
  class: [
    'usa-card__media',
    media_variant == 'inset' ? 'usa-card__media--inset',
    media_variant == 'exdent' ? 'usa-card__media--exdent',
  ]
} %}



<{{ list ? 'li' : 'div' }} id="{{ card_id }}" {{ attributes.addClass(card_classes) }}>
  <div class="usa-card__container">
    {% if header_first %}
      <div class="usa-card__header">
				<h{{ heading_level|default(2) }} id="{{ card_id }}-heading" class="usa-card__heading">{{ heading }}</h{{ heading_level|default(2) }}>
      </div>
    {% endif %}

   {% if media.uri %}
      <div class="{{ media_attributes.class|join(' ') }}">
        <div class="usa-card__img">
          <img src="{{ media.uri }}" alt="{{ media.alt }}">

        </div>
      </div>
    {% endif %}

    {% if not header_first %}
      <div class="usa-card__header">
        <h{{ heading_level|default(2) }} id="{{ card_id }}-heading" class="usa-card__heading">{{ heading }}</h{{ heading_level|default(2) }}>
      </div>
    {% endif %}

    <div class="usa-card__body">
      {{ body }}
    </div>

     {% if footer.button_text %}
      <div class="usa-card__footer">
        {% include 'drupito_components_uswds:button' with {
          button_text: footer.button_text,
          button_url: footer.button_url,
          variant: 'default'
        } only %}
      </div>
    {% endif %}
          
  </div>
</{{ list ? 'li' : 'div' }}>

