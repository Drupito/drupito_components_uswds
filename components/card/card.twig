{#
  Props:
    - header_text: Optional card header text.
    - media_image: Optional image URL.
    - media_alt: Alternative text for the image.
    - body_text: Main card content.
    - footer_text: Text for the footer button.
    - footer_url: If provided, renders the footer as a link.
    - layout: Determines the card layout. Options are:
        • default (regular card)
        • header_first (header comes before media)
        • inset_media (media is indented)
        • exdent_media (media extends to the card edge)
        • flag (flag layout, horizontal orientation)
    - flag_media_position: (Only for flag layout) "left" (default) or "right" (adds a modifier).
#}

{% set layout_classes = ['usa-card'] %}


{% if layout == 'flag' %}
{% set layout_classes = layout_classes|merge(['usa-card--flag']) %}


{% elseif layout == 'header_first' %}
{% set layout_classes = layout_classes|merge(['usa-card--header-first']) %}{% elseif layout == 'inset_media' %}
{% set layout_classes = layout_classes|merge(['usa-card__media--inset']) %}{% elseif layout == 'exdent_media' %}
{% set layout_classes = layout_classes|merge(['usa-card__media--exdent']) %}


{% endif %}
{% set unique_id = 'card-' ~ loop.index %}


<li class="{{ layout_classes|join(' ') }}">
	<div id="{{ unique_id }}" class="usa-card__container">


		{% if header_text %}
			<div class="usa-card__header">
				<h4 class="usa-card__heading">{{ header_text }}</h4>
			</div>
		{% endif %}
{% if has_media %}
	<div class="usa-card__media">


				<div class="usa-card__img">
					<img src="{{ media_image }}" alt="{{ media_alt }}">
				</div>
			</div>
		{% endif %}
		<div class="usa-card__body">
			{{ body_text|raw }}
		</div>
		{% if footer_text %}
			<div class="usa-card__footer">
{% if footer_type == 'link' and footer_url %}


					<a href="{{ footer_url }}" class="usa-button">{{ footer_text }}</a>
				{% else %}
					<button type="button" class="usa-button">{{ footer_text }}</button>
				{% endif %}
			</div>
		{% endif %}
	</div>
</li>

