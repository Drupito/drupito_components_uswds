{% do attributes.addClass('usa-card') %}

{% if variant == 'default' %}
  {% do attributes.addClass('tablet-lg:grid-col-6', 'widescreen:grid-col-4') %}
  {% if media_first %}
    {% do attributes.addClass('usa-card--header-first') %}
  {% endif %}
{% elseif variant == 'flag' %}
  {% do attributes.addClass('usa-card--flag', 'flex-1') %}
  {% if media_position == 'right' %}
    {% do attributes.addClass('usa-card--media-right') %}
  {% endif %}
{% endif %}
{% set heading_level = heading_level|default(2) %}

{# Create a new attributes object for media #}
{% set media_attributes = create_attribute().addClass('usa-card__media') %}

{# Add media style classes conditionally #}
{% if media_style == 'inset' %}
  {% do media_attributes.addClass('usa-card__media--inset') %}
{% elseif media_style == 'exdent' %}
  {% do media_attributes.addClass('usa-card__media--exdent') %}
{% endif %}

<li{{ attributes }}>
  <div class="usa-card__container">
    {% if media_first and image_url %}
      <div{{ media_attributes }}>
        <div class="usa-card__img">
          <img src="{{ image_url }}" alt="{{ image_alt }}">
        </div>
      </div>
    {% endif %}

    <div class="usa-card__header">
      <h{{ heading_level }} class="usa-card__heading">{{ heading }}</h{{ heading_level }}>
    </div>

    {% if not media_first and image_url %}
      <div{{ media_attributes }}>
        <div class="usa-card__img">
          <img src="{{ image_url }}" alt="{{ image_alt }}">
        </div>
      </div>
    {% endif %}

    <div class="usa-card__body">
      <p>{{ body }}</p>
    </div>

    {% if button_text or button_url %}
      <div class="usa-card__footer">
        <a href="{{ button_url }}" class="usa-button">{{ button_text }}</a>
      </div>
    {% endif %}
  </div>
</li>
