{# Default Collection #}
{% embed "drupito_components_uswds:collection" only %}
    {% embed "drupito_components_uswds:collection_item" with { 
        author_name: 'By Sondra Ainsworth and Constance Lu',
        published_date: 'September 30, 2020',
        tag_text: "NEW",
        is_new: true
    } only %}
        {% block heading_link %}
            <a href="https://trumpadministration.archives.performance.gov/presidents-winners-press-release/">
                Gears of Government President’s Award winners
            </a>
        {% endblock %}
        {% block body %}
            <p>Today, the Administration announces the winners of the Gears of Government President’s Award...</p>
        {% endblock %}
    {% endembed %}

    {% embed "drupito_components_uswds:collection_item" with { 
        author_name: 'By Constance Lu',
        published_date: 'September 30, 2020'
    } only %}
        {% block heading_link %}
            <a href="https://trumpadministration.archives.performance.gov/sba-wosb-dashboard/">
                Women-owned small business dashboard
            </a>
        {% endblock %}
        {% block body %}
            <p>We’ve partnered with SBA to highlight the Women-Owned Small Businesses (WOSBs) data dashboard!</p>
        {% endblock %}
    {% endembed %}

    {% embed "drupito_components_uswds:collection_item" with { 
        author_name: 'By Eric L. Miller',
        published_date: 'September 17, 2020'
    } only %}
        {% block heading_link %}
            <a href="https://trumpadministration.archives.performance.gov/September-2020-Updates-Show-Progress/">
                September 2020 updates show progress on priority goals
            </a>
        {% endblock %}
        {% block body %}
            <p>Today, we published updates for both Cross-Agency Priority Goals and Agency Priority Goals for Q3 FY2020...</p>
        {% endblock %}
    {% endembed %}
{% endembed %}

