<h1>Button Group Test</h1>

{# Test Case 1: Default Button Group #}

{% embed "drupito_components_uswds:button-group" with {
  segmented: false
} only %}
{% block button_1 %}
    {% embed "drupito_components_uswds:button" with { button_text: 'Back', outline: true } only %}{% endembed %}
  {% endblock %}
  
  {% block button_2 %}
    {% embed "drupito_components_uswds:button" with { button_text: 'Continue' } only %}{% endembed %}
  {% endblock %}
{% endembed %}

